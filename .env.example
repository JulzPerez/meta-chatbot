# Copy this to .env and fill in your values. Never commit .env.

# A secret string you choose — must match what you register in the Meta App Dashboard
META_VERIFY_TOKEN=your_verify_token_here

# Meta App Dashboard → App Settings → Basic → App Secret
META_APP_SECRET=your_app_secret_here

# Meta App Dashboard → WhatsApp/Messenger → Page Access Token
PAGE_ACCESS_TOKEN=your_page_access_token_here

# ── AI Provider ────────────────────────────────────────────────────────────────
# Which AI to use: "claude", "openai", or "gemini"
AI_PROVIDER=claude

# Optional: override the default model for the chosen provider.
# Defaults: claude → claude-sonnet-4-6 | openai → gpt-4o | gemini → gemini-2.0-flash
AI_MODEL=

# Personality / instructions for the bot
AI_SYSTEM_PROMPT=You are a helpful and friendly assistant.

# Only the key matching your chosen AI_PROVIDER is required.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
