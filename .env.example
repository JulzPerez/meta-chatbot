# Copy this to .env and fill in your values. Never commit .env.

# A secret string you choose — must match what you register in the Meta App Dashboard
META_VERIFY_TOKEN=your_verify_token_here

# Meta App Dashboard → App Settings → Basic → App Secret
META_APP_SECRET=your_app_secret_here

# Meta App Dashboard → WhatsApp/Messenger → Page Access Token
PAGE_ACCESS_TOKEN=your_page_access_token_here
